rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A real account (Google or email), not a guest who joined with a code.
    function hasAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Saved courses are private to each person.
    match /users/{uid}/courses/{courseId} {
      allow read, write: if hasAccount() && request.auth.uid == uid;
    }

    // So are your mates and crews.
    match /users/{uid}/mates/{mateId} {
      allow read, write: if hasAccount() && request.auth.uid == uid;
    }
    match /users/{uid}/crews/{crewId} {
      allow read, write: if hasAccount() && request.auth.uid == uid;
    }

    // Join codes: codes/{CODE} -> { roundId, ownerId }. Anyone signed in (guests too) can look
    // up one code they typed, but nobody can list them. Creating fails if the code is taken.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if hasAccount() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Greens players saved by standing on them: greens/{course}/holes/{hole}. Everyone signed in
    // reads them; anyone with an account saves or fixes one (newest wins), as themselves, in South Africa.
    match /greens/{course}/holes/{hole} {
      allow read: if request.auth != null;
      allow create, update: if hasAccount()
        && hole.matches('^[1-9][0-9]?$')
        && request.resource.data.keys().hasOnly(['lat', 'lon', 'by', 'byName', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 60
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.lat > -35.5 && request.resource.data.lat < -21.5
        && request.resource.data.lon > 16 && request.resource.data.lon < 33.5
        && request.resource.data.at == request.time;
    }

    match /rounds/{roundId} {
      function me() { return request.auth.uid; }
      function isOwner() { return me() == resource.data.ownerId; }
      function isMember() { return me() in resource.data.memberIds; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // claims = { uid: player index }. You can only add yourself, once.
      function claimsOk() {
        return !('claims' in changed())
          || (request.resource.data.claims.diff(resource.data.claims).affectedKeys().hasOnly([me()])
              && !(me() in resource.data.claims)
              && request.resource.data.claims[me()] is int);
      }
      // memberNames = { uid: name }. You can only change your own.
      function namesOk() {
        return !('memberNames' in changed())
          || request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([me()]);
      }

      allow read: if request.auth != null && isMember();

      allow create: if hasAccount()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()];

      allow update: if request.auth != null && (
        // The starter can change anything except who owns the round and its code.
        (isOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('code', null) == resource.data.get('code', null))
        // Players score, set closest to the pin, claim their name and set their own name,
        // until the round is finished.
        || (isMember() && !resource.data.done
          && changed().hasOnly(['scores', 'ctp', 'claims', 'memberNames'])
          && claimsOk() && namesOk())
        // Joining: add yourself (you only know the round's id if you had the code).
        || (!isMember()
          && changed().hasOnly(['memberIds', 'memberNames'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && me() in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 12
          && namesOk())
        // Leaving: take yourself off. The starter can't leave, only delete.
        || (isMember() && !isOwner()
          && changed().hasOnly(['memberIds', 'memberNames'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([me()])
          && namesOk())
      );

      allow delete: if request.auth != null && isOwner();
    }
  }
}
