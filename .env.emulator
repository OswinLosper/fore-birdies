# Used by `npm run dev:emu`: a local fake Firebase on this Mac. No real project, no real accounts.
# "demo-" project ids never touch Google's servers.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fore-birdies.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-fore-birdies
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=1
