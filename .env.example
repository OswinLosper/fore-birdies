# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup (Config).
# .env.local is git-ignored, so the values never go into the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Esri satellite photos for the hole map (ArcGIS Location Platform key, basemap only,
# limited to fore-birdies.vercel.app and localhost). Without it the Hole map button is hidden.
VITE_ESRI_KEY=
